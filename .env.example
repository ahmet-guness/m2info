# Telegram Bot Ayarları
TELEGRAM_BOT_TOKEN=buraya_bot_token_yazin
TELEGRAM_CHAT_ID=buraya_chat_id_yazin

# Forum kontrol aralığı (saniye cinsinden, varsayılan: 180 saniye = 3 dakika)
CHECK_INTERVAL_SECONDS=180

# G-Status canlı durum kontrol aralığı (saniye cinsinden, varsayılan: 60 saniye = 1 dakika)
STATUS_CHECK_INTERVAL_SECONDS=60

# Bot ilk açıldığında en son mutlu saatler konusunu hemen göndersin mi? (true / false)
NOTIFY_ON_FIRST_RUN=false

# Sunucu haberlerinde ve canlı takipte izlenecek sunucu adı (örn: Bagjanamu)
TRACKED_SERVER=Bagjanamu

# Canlı başlangıç bildirimi gönderilecek etkinlikler (virgülle ayrılmış, boş bırakılırsa varsayılan liste kullanılır)
# Varsayılan: Kötü Ruh Kovma Kağıdı, Cor Draconis, Küçük Kutsama, Nesneyi Efsunla, Ay Işığı, Balıkçılık, Münzevi Tavsiyesi, Envanter Genişletme
TRACKED_EVENTS=Kötü Ruh Kovma Kağıdı, Cor Draconis, Küçük Kutsama, Nesneyi Efsunla, Ay Işığı, Balıkçılık, Münzevi Tavsiyesi, Envanter Genişletme
